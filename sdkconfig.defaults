# FSD §2.2: ESP32-C3, 4 MB flash (C-HW-02), custom dual-OTA layout (C-HW-06).
CONFIG_IDF_TARGET="esp32c3"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x8000

# FSD §16 / FR-UPD-06. The bootloader is never updated over the air, so the
# rollback support must be in the first image flashed over USB.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# FSD C-HW-05: console on the USB Serial/JTAG controller.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
